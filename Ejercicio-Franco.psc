Algoritmo sin_titulo
	// Realizar un program que solicite al usuario el ingreso
	// de dos valores numericos. Sume ambos numeros y muestre el
	// resultado luego sume el resultado con el valor 2026 y
	// muestren el resultado
	Definir num1, num2, num3, num4 Como Entero
	Escribir 'Ingrese el primer numero:'
	Leer num1
	Escribir 'Ingrese el segundo numero:'
	Leer num2
	num3 <- num1+num2
	num4 <- num3+2026
	Escribir 'El resultado de la suma de ambos es:', num3
	Escribir 'Al sumar este numero con 2026 el resultado es:', num4
	Escribir 'Al sumar este numero con los dos primeros numeros solicitados el resultado es:', num4+num1+num2
FinAlgoritmo
